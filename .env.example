# ─── Workers API (workers/api) — 仅服务端，切勿暴露到前端 ──────────
# 模式 B 时写入 workers/api/.dev.vars（勿提交）。飞书：FEISHU_APP_ID / FEISHU_APP_SECRET
# 线上已用 wrangler secret；日常联调前端无需本机飞书密钥。
GITHUB_TOKEN=
GITHUB_REPO=your-name/webbook-data
GITHUB_BRANCH=main

AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

